// Droplet Aura design tokens (aura-ds/project/tokens.json), metrics aligned on the Apple
// macOS 27 kit (documentation/MACOS27-MESURES.md)
pragma Singleton
import QtQuick
import Droplet

QtObject {
    id: theme
    readonly property bool dark: SystemControl.darkMode

    // ---- colour (Aura tokens, #AARRGGBB for Qt)
    readonly property color goutte: dark ? "#ff375f" : "#ff2d55"
    readonly property color goutteRemplie: dark ? "#ec002d" : "#ec002d"
    readonly property color goutteVoile: dark ? "#2eff375f" : "#1fff2d55"
    readonly property color focus: dark ? "#99ff375f" : "#80ff2d55"
    readonly property color label: dark ? "#d9ffffff" : "#d9000000"          // kit Labels/Primary 85 %
    readonly property color label2: dark ? "#8cffffff" : "#80000000"         // Secondary 55 % / 50 %
    readonly property color label3: dark ? "#40ffffff" : "#40000000"         // Tertiary 25 %
    readonly property color labelInactif: dark ? "#40ffffff" : "#40000000"
    readonly property color surAccent: dark ? "#ffffff" : "#ffffff"
    readonly property color bureauNuit: dark ? "#05070c" : "#05070c"
    readonly property color fenetre: dark ? "#16181f" : "#f6f6f8"
    readonly property color fenetreContenu: dark ? "#1e1e1e" : "#ffffff"   // kit Window Background
    readonly property color element: dark ? "#14ffffff" : "#14000000"        // Fills/Secondary 8 %
    readonly property color elementSurvol: dark ? "#26ffffff" : "#1a000000"  // menu hover (kit #E6E6E6 burn)
    readonly property color selection: dark ? "#1cffffff" : "#0f000000"
    readonly property color separateur: dark ? "#1fffffff" : "#1a000000"
    readonly property color lisereInterne: dark ? "#21ffffff" : "#b3ffffff"
    readonly property color lisereExterne: dark ? "#8c000000" : "#2e000000"
    readonly property color verreCapsule: dark ? "#6b2a2d36" : "#8cffffff"
    readonly property color verreLateral: dark ? "#4d3b3f4c" : "#b3f2f2f5"
    readonly property color verreFlottant: dark ? "#570d0f16" : "#80f7f7fa"
    readonly property color verreMenu: dark ? "#b822242c" : "#c7f4f4f7"
    readonly property color verreDock: dark ? "#3362646b" : "#59ffffff"
    readonly property color etiquetteRouge: dark ? "#ff453a" : "#ff3b30"
    readonly property color etiquetteOrange: dark ? "#ff9f0a" : "#ff9500"
    readonly property color etiquetteJaune: dark ? "#ffd60a" : "#ffcc00"
    readonly property color etiquetteVert: dark ? "#30d158" : "#34c759"
    readonly property color etiquetteCyan: dark ? "#64d2ff" : "#32ade6"
    readonly property color etiquetteBleu: dark ? "#0a84ff" : "#007aff"
    readonly property color etiquetteViolet: dark ? "#bf5af2" : "#af52de"
    readonly property color etiquetteGraphite: dark ? "#98989d" : "#8e8e93"
    readonly property color succes: dark ? "#30d158" : "#107a43"
    readonly property color attention: dark ? "#ff9f0a" : "#9f5300"
    readonly property color erreur: dark ? "#ff453a" : "#d12b21"
    readonly property color dossier: dark ? "#4f9dff" : "#3c8bf5"
    readonly property color ombre: "#4d000000"

    // ---- type
    readonly property string texte: "Inter"
    readonly property string titres: "Inter Display"   // optical size for large text (fonts-inter, OFL)
    // Apple HIG tracking table (size pt -> tracking pt), same table as the design renders
    readonly property var _hig: ({6: .24, 7: .23, 8: .21, 9: .17, 10: .12, 11: .06, 12: 0.0, 13: -.08, 14: -.15,
                                  15: -.23, 16: -.31, 17: -.43, 18: -.44, 19: -.45, 20: -.45, 21: -.36, 22: -.26,
                                  23: -.10, 24: .07})
    function tracking(px) {
        const k = Math.round(px)
        return _hig[k] !== undefined ? _hig[k] : (k > 24 ? 0.07 : 0.24)
    }

    // ---- metrics (points == logical px)
    readonly property int barreMenus: 24
    readonly property int ecartMenus: 22
    readonly property int rayonFenetre: 16        // kit Window BG
    readonly property int rayonWidget: 24
    readonly property int rayonDock: 22           // kit 15 at 36 pt icons, x 52/36
    readonly property int rayonDialogue: 20       // kit popovers / notifications
    readonly property int rayonMenu: 12           // kit Menu Background
    readonly property int rayonChamp: 9
    readonly property int rayonSelection: 8       // kit menu hover / sidebar item
    readonly property int iconeDock: 52
    readonly property int rayonNotification: 20
    readonly property int largeurNotification: 344
    readonly property int rayonControle: 6        // kit Global/Radius (Medium, 24 pt)
    readonly property int hauteurControle: 24

    // ---- motion (generated by aura/render/motion.py: Apple-style springs fitted as Bezier splines)
    // Every animation in the shell uses one of these characters, through Ressort.qml.
    // doux: ressort réponse 0.42 s, amortissement 1.0 — panneaux, tailles, mises en page (aucun dépassement) (dépassement 0.0 %)
    readonly property int douxDuree: 514
    readonly property var douxCourbe: [0.0084, 0.0000, 0.0167, 0.0062, 0.0251, 0.0164, 0.0421, 0.0372, 0.0591, 0.0745, 0.0761, 0.1172, 0.0993, 0.1753, 0.1225, 0.2432, 0.1457, 0.3084, 0.1741, 0.3881, 0.2024, 0.4640, 0.2308, 0.5297, 0.2638, 0.6060, 0.2969, 0.6692, 0.3299, 0.7201, 0.3671, 0.7776, 0.4044, 0.8201, 0.4416, 0.8527, 0.4828, 0.8887, 0.5240, 0.9129, 0.5651, 0.9307, 0.6100, 0.9501, 0.6549, 0.9621, 0.6998, 0.9706, 0.7481, 0.9798, 0.7965, 0.9850, 0.8449, 0.9887, 0.8966, 0.9926, 0.9483, 1.0000, 1.0000, 1.0000]
    // vif: ressort réponse 0.28 s, amortissement 0.86 — pression, interrupteurs, survol, sélection (dépassement 0.5 %)
    readonly property int vifDuree: 311
    readonly property var vifCourbe: [0.0084, 0.0000, 0.0167, 0.0051, 0.0251, 0.0139, 0.0421, 0.0318, 0.0591, 0.0647, 0.0761, 0.1041, 0.0993, 0.1579, 0.1225, 0.2236, 0.1457, 0.2892, 0.1741, 0.3695, 0.2024, 0.4496, 0.2308, 0.5208, 0.2638, 0.6035, 0.2969, 0.6745, 0.3299, 0.7320, 0.3671, 0.7969, 0.4044, 0.8452, 0.4416, 0.8811, 0.4828, 0.9209, 0.5240, 0.9460, 0.5651, 0.9631, 0.6100, 0.9818, 0.6549, 0.9911, 0.6998, 0.9967, 0.7481, 1.0027, 0.7965, 1.0043, 0.8449, 1.0048, 0.8966, 1.0054, 0.9483, 1.0000, 1.0000, 1.0000]
    // rebond: ressort réponse 0.48 s, amortissement 0.72 — apparition de popovers, Dock, notifications (léger dépassement) (dépassement 3.8 %)
    readonly property int rebondDuree: 551
    readonly property var rebondCourbe: [0.0084, 0.0000, 0.0167, 0.0055, 0.0251, 0.0150, 0.0421, 0.0345, 0.0591, 0.0708, 0.0761, 0.1151, 0.0993, 0.1754, 0.1225, 0.2503, 0.1457, 0.3256, 0.1741, 0.4179, 0.2024, 0.5106, 0.2308, 0.5920, 0.2638, 0.6867, 0.2969, 0.7663, 0.3299, 0.8280, 0.3671, 0.8976, 0.4044, 0.9449, 0.4416, 0.9762, 0.4828, 1.0109, 0.5240, 1.0266, 0.5651, 1.0336, 0.6100, 1.0412, 0.6549, 1.0387, 0.6998, 1.0344, 0.7481, 1.0297, 0.7965, 1.0227, 0.8449, 1.0172, 0.8966, 1.0113, 0.9483, 1.0000, 1.0000, 1.0000]
    // sortie: ease-in, things leave faster than they arrive
    readonly property int sortieDuree: 200
    readonly property var sortieCourbe: [0.30, 0.0, 0.80, 0.15, 1.0, 1.0]
    // fondu: cross-fades, colour changes
    readonly property int fonduDuree: 180
    readonly property var fonduCourbe: [0.25, 0.1, 0.25, 1.0, 1.0, 1.0]
    // instant: menu highlight (macOS draws it without a fade)
    function duree(c) { return c === "vif" ? vifDuree : c === "rebond" ? rebondDuree : c === "sortie" ? sortieDuree
                             : c === "fondu" ? fonduDuree : douxDuree }
    function courbe(c) { return c === "vif" ? vifCourbe : c === "rebond" ? rebondCourbe : c === "sortie" ? sortieCourbe
                              : c === "fondu" ? fonduCourbe : douxCourbe }
    // legacy durations, kept for the wallpaper films
    readonly property int instant: 100
    readonly property int rapide: 200
    readonly property int standard: 300
    readonly property int lent: 450
    readonly property int scene: 700

    function symbol(name) { return Shell.dataDir + "/symbols/" + name + ".svg" }
    function icon(name) { return Shell.dataDir + "/icons/" + name + ".png" }
    readonly property url wallpaper: Shell.dataDir + "/wallpapers/" + "eclipse-lumineux.jpg"
}
