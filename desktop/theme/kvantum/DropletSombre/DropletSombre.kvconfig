[%General]
author=Droplet OS
comment=Droplet sombre — macOS 27 kit metrics, Droplet accent
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=false
center_doc_tabs=true
center_normal_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
menu_separator_height=11
scroll_width=11
scroll_arrows=false
scroll_min_extent=36
transient_scrollbar=true
transient_groove=true
slider_width=4
slider_handle_width=20
slider_handle_length=16
tickless_slider_handle_size=20
check_size=16
textless_progressbar=false
progressbar_thickness=6
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
popup_blurring=true
vertical_spin_indicators=false
inline_spin_indicators=true
fill_rubberband=true
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=18
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=false
remove_extra_frames=true
animate_states=true
no_inactiveness=true
dialog_button_layout=3
layout_spacing=8
layout_margin=16
submenu_overlap=0
menu_blur_radius=0
contrast=1.00
intensity=1.00
saturation=1.00

[GeneralColors]
window.color=#1e1e1e
base.color=#1e1e1e
alt.base.color=#252525
button.color=#3d3d3d
light.color=#1e1e1e
mid.light.color=#252525
dark.color=#3d3d3d
mid.color=#363636
highlight.color=#ec002d
inactive.highlight.color=#454545
text.color=#d9d9d9
window.text.color=#d9d9d9
button.text.color=#d9d9d9
disabled.text.color=#5c5c5c
tooltip.text.color=#d9d9d9
highlight.text.color=#ffffff
link.color=#ff375f
link.visited.color=#bf5af2
progress.indicator.text.color=#d9d9d9

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=false
iconless_pushbutton=true
iconless_menu=false
transparent_arrow_button=true
single_top_toolbar=true
no_selection_tint=true
centered_forms=false
kcapacitybar_as_progressbar=true
middle_click_scroll=false
normal_default_pushbutton=true
tint_on_mouseover=0
disabled_icon_opacity=40
lxqtmainmenu_iconsize=16
tint_on_mouseover=0

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
interior.element=button
indicator.size=10
indicator.element=arrow
text.normal.color=#d9d9d9
text.focus.color=#d9d9d9
text.press.color=#d9d9d9
text.toggle.color=#d9d9d9
text.disabled.color=#5c5c5c
text.shadow=0
text.margin=1
text.iconspacing=6
text.margin.top=0
text.margin.bottom=0
text.margin.left=10
text.margin.right=10
min_width=+0.5font
min_height=+0.2font
frame.expansion=0

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
text.margin.left=4
text.margin.right=4

[Dock]
inherits=PanelButtonCommand
frame=false
interior=false

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=arrow

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.margin.left=4

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.margin.left=4

[Focus]
inherits=PanelButtonCommand
frame=false
frame.element=focus
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=false

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=2
text.margin.right=2

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=10
text.margin.right=10
text.margin.top=1
text.margin.bottom=1
indicator.element=tab
indicator.size=12
focusFrame=false
min_width=4font

[TabBarFrame]
inherits=PanelButtonCommand
frame=true
interior=true
frame.element=tabbarframe
interior.element=tabbarframe
frame.top=7
frame.bottom=7
frame.left=7
frame.right=7

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior.element=tabframe
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=10
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.bold=false
text.normal.color=#8c8c8c
text.margin.left=6
text.margin.right=6

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=toolbar
indicator.size=5
text.margin=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin=0
text.bold=false
text.normal.color=#8c8c8c

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
text.press.color=#ffffff
text.toggle.color=#ffffff
min_width=0
min_height=0

[Splitter]
indicator.size=32

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=10

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=4
frame.right=4
frame.top=4
frame.bottom=4
indicator.element=grip
indicator.size=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.top=0
text.margin.bottom=0
text.margin.left=6
text.margin.right=6
text.focus.color=#d9d9d9
text.press.color=#d9d9d9
min_width=0
min_height=+0.4font

[MenuBar]
inherits=PanelButtonCommand
frame=false
interior=false

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.margin.left=4
text.margin.right=4

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior=false
text.bold=true

[ComboBox]
inherits=PanelButtonCommand
indicator.element=arrow-down

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
frame.top=12
frame.bottom=12
frame.left=12
frame.right=12
text.normal.color=#d9d9d9

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
interior=true
interior.element=group
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
text.bold=true
text.margin=0

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior.element=tooltip
interior=true
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
text.normal.color=#d9d9d9

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
frame=false
