// Droplet OS — login screen (SDDM, Qt 6), harmonised with the desktop:
// the same living wallpaper (garden by day, the night body of the hour by night), the same glass
// for the avatar, the password capsule and the power buttons.
import QtQuick
import QtQuick.Effects

Rectangle {
    id: root
    width: 1440; height: 900
    color: "#05070c"

    readonly property string data_: "/usr/share/droplet/"
    readonly property var loc: Qt.locale("fr_FR")
    readonly property var bodies: ["eclipse", "mercure", "venus", "terre", "mars", "jupiter", "saturne", "uranus", "neptune"]
    property date now: new Date()
    readonly property bool day: now.getHours() >= 7 && now.getHours() < 19
    readonly property string body: bodies[Math.floor(now.getTime() / 3600000) % bodies.length]
    readonly property color label: "#f5f5f7"
    readonly property string texte: "Inter"

    property int userIndex: userModel.lastIndex >= 0 ? userModel.lastIndex : 0
    property int sessionIndex: {
        for (let i = 0; i < sessionModel.rowCount(); ++i)
            if (String(sessionModel.data(sessionModel.index(i, 0), Qt.UserRole + 4)).indexOf("droplet") >= 0) return i
        return sessionModel.lastIndex
    }
    property string userName: ""
    property string realName: ""
    property bool busy: false
    // ---- motion: the same springs as the desktop (copied from the shell's Theme.qml, generated by
    // aura/render/motion.py; the greeter cannot load the shell's QML module)
    readonly property var springs: ({
        doux: [514, [0.0084, 0.0000, 0.0167, 0.0062, 0.0251, 0.0164, 0.0421, 0.0372, 0.0591, 0.0745, 0.0761, 0.1172, 0.0993, 0.1753, 0.1225, 0.2432, 0.1457, 0.3084, 0.1741, 0.3881, 0.2024, 0.4640, 0.2308, 0.5297, 0.2638, 0.6060, 0.2969, 0.6692, 0.3299, 0.7201, 0.3671, 0.7776, 0.4044, 0.8201, 0.4416, 0.8527, 0.4828, 0.8887, 0.5240, 0.9129, 0.5651, 0.9307, 0.6100, 0.9501, 0.6549, 0.9621, 0.6998, 0.9706, 0.7481, 0.9798, 0.7965, 0.9850, 0.8449, 0.9887, 0.8966, 0.9926, 0.9483, 1.0000, 1.0000, 1.0000]], vif: [311, [0.0084, 0.0000, 0.0167, 0.0051, 0.0251, 0.0139, 0.0421, 0.0318, 0.0591, 0.0647, 0.0761, 0.1041, 0.0993, 0.1579, 0.1225, 0.2236, 0.1457, 0.2892, 0.1741, 0.3695, 0.2024, 0.4496, 0.2308, 0.5208, 0.2638, 0.6035, 0.2969, 0.6745, 0.3299, 0.7320, 0.3671, 0.7969, 0.4044, 0.8452, 0.4416, 0.8811, 0.4828, 0.9209, 0.5240, 0.9460, 0.5651, 0.9631, 0.6100, 0.9818, 0.6549, 0.9911, 0.6998, 0.9967, 0.7481, 1.0027, 0.7965, 1.0043, 0.8449, 1.0048, 0.8966, 1.0054, 0.9483, 1.0000, 1.0000, 1.0000]], rebond: [551, [0.0084, 0.0000, 0.0167, 0.0055, 0.0251, 0.0150, 0.0421, 0.0345, 0.0591, 0.0708, 0.0761, 0.1151, 0.0993, 0.1754, 0.1225, 0.2503, 0.1457, 0.3256, 0.1741, 0.4179, 0.2024, 0.5106, 0.2308, 0.5920, 0.2638, 0.6867, 0.2969, 0.7663, 0.3299, 0.8280, 0.3671, 0.8976, 0.4044, 0.9449, 0.4416, 0.9762, 0.4828, 1.0109, 0.5240, 1.0266, 0.5651, 1.0336, 0.6100, 1.0412, 0.6549, 1.0387, 0.6998, 1.0344, 0.7481, 1.0297, 0.7965, 1.0227, 0.8449, 1.0172, 0.8966, 1.0113, 0.9483, 1.0000, 1.0000, 1.0000]],
        sortie: [200, [0.30, 0.0, 0.80, 0.15, 1.0, 1.0]], fondu: [180, [0.25, 0.1, 0.25, 1.0, 1.0, 1.0]] })
    component Ressort: NumberAnimation {
        property string caractere: "doux"
        duration: root.springs[caractere][0]
        easing.type: Easing.BezierSpline
        easing.bezierCurve: root.springs[caractere][1]
    }
    // arrival: the clock settles, then the avatar, then the password capsule (60 ms apart)
    property real arrive: 0
    SequentialAnimation on arrive { running: true; PauseAnimation { duration: 250 }
        NumberAnimation { to: 1; duration: 900; easing.type: Easing.Linear } }
    function stage(k) { return Math.max(0, Math.min(1, (arrive * 900 - k * 60) / 520)) }
    function settle(u) { // the "rebond" spring evaluated directly (response 0.48 s, damping 0.72)
        const w0 = 2 * Math.PI / 0.48, z = 0.72, wd = w0 * Math.sqrt(1 - z * z), a = z * w0, t = u * 0.52
        return u >= 1 ? 1 : 1 - Math.exp(-a * t) * (Math.cos(wd * t) + a / wd * Math.sin(wd * t)) }
    function tracking(px) { const t = {11: .06, 12: 0, 13: -.08, 15: -.23, 17: -.43, 22: -.26}; return t[px] !== undefined ? t[px] : 0 }

    // the screen shows minutes only: wake on the minute, never more often
    Timer {
        running: true; repeat: false
        interval: 60000 - (new Date().getSeconds() * 1000 + new Date().getMilliseconds()) + 50
        onTriggered: {
            root.now = new Date()
            interval = 60000 - (root.now.getSeconds() * 1000 + root.now.getMilliseconds()) + 50
            restart()
        }
    }

    Repeater {
        model: userModel
        delegate: Item {
            required property int index
            required property string name
            required property string realName
            Component.onCompleted: if (index === root.userIndex) { root.userName = name; root.realName = realName || name }
        }
    }

    // ---------------------------------------------------------------- wallpaper
    Image {
        id: wall
        anchors.fill: parent
        fillMode: Image.PreserveAspectCrop
        source: root.data_ + "wallpapers/" + (root.day ? "jour/fond.jpg" : "nuit/" + root.body + ".jpg")
        sourceSize: Qt.size(1920, 1200)
    }
    Item {   // the garden's clouds keep drifting
        id: stage
        visible: root.day
        width: 1440; height: 900
        anchors.centerIn: parent
        scale: Math.max(root.width / 1440, root.height / 900)
        // 12 Hz is smooth for clouds that move a few points per second (a 60 Hz animation
        // would redraw the whole screen 60 times per second)
        property real t: 0
        Timer { interval: 83; repeat: true; running: stage.visible; onTriggered: stage.t += 0.083 }
        Repeater {
            model: [[300, 190, 7.5, 190], [700, 120, 4.0, 120], [880, 335, 9.5, 150], [1380, 175, 5.5, 120], [90, 360, 11.0, 110]]
            delegate: Image {
                required property var modelData
                required property int index
                readonly property real span: 1440 + 2 * modelData[3] + 200
                readonly property real cx: ((modelData[0] + modelData[2] * stage.t + modelData[3] + 100) % span) - modelData[3] - 100
                source: root.data_ + "wallpapers/jour/nuage-" + index + "-a.png"
                x: cx - modelData[3] * 1.3
                y: modelData[1] - (sourceSize.height / (1920 / 1440)) * 0.65
                width: sourceSize.width / (1920 / 1440); height: sourceSize.height / (1920 / 1440)
                smooth: true
            }
        }
    }
    // a soft veil top and bottom so white type reads on any picture
    Rectangle {
        anchors.fill: parent
        gradient: Gradient {
            GradientStop { position: 0.0; color: "#38000000" }
            GradientStop { position: 0.32; color: "#00000000" }
            GradientStop { position: 0.7; color: "#00000000" }
            GradientStop { position: 1.0; color: "#4d000000" }
        }
    }

    // glass (the compositor effect only serves the desktop session, so the greeter draws its own)
    component Glass: Item {
        id: g
        property real radius: 18
        property color tint: root.day ? "#59ffffff" : "#40101219"
        default property alias content: inner.data
        RectangularShadow {
            anchors.fill: parent; anchors.topMargin: 8; anchors.bottomMargin: -4
            radius: g.radius; blur: 24; spread: -6; color: "#40000000"
        }
        Rectangle { anchors.fill: parent; radius: g.radius; color: g.tint }
        Rectangle {   // hairline rim, brighter at the top (light from above)
            anchors.fill: parent
            radius: g.radius
            color: "transparent"
            border.width: 1
            border.color: "#40ffffff"
        }
        Rectangle {
            anchors.fill: parent; anchors.margins: 1
            radius: g.radius - 1
            color: "transparent"
            border.width: 1
            border.color: "#26ffffff"
            opacity: .9
        }
        Item { id: inner; anchors.fill: parent }
    }

    // ---------------------------------------------------------------- status (top right)
    Text {
        anchors.right: parent.right; anchors.rightMargin: 24; y: 14
        visible: keyboard.layouts.length > 0
        text: keyboard.layouts.length > 0 ? String(keyboard.layouts[keyboard.currentLayout].shortName).toUpperCase() : ""
        color: root.label
        font.family: root.texte; font.pixelSize: 12; font.weight: Font.DemiBold
    }

    // ---------------------------------------------------------------- clock
    Column {
        anchors.horizontalCenter: parent.horizontalCenter
        y: Math.round(root.height * 0.10) + 14 * (1 - root.settle(root.stage(0)))
        opacity: root.stage(0)
        spacing: -8
        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: { const s = root.now.toLocaleDateString(root.loc, "dddd d MMMM"); return s.charAt(0).toUpperCase() + s.slice(1) }
            color: root.label; opacity: .92
            font.family: root.texte; font.pixelSize: 22; font.weight: Font.DemiBold
            font.letterSpacing: root.tracking(22)
        }
        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.now.toLocaleTimeString(root.loc, "HH:mm")
            color: root.label; opacity: .94
            font.family: "Inter Display"; font.pixelSize: 118; font.weight: Font.DemiBold
            font.letterSpacing: -2.5
        }
    }

    // ---------------------------------------------------------------- user + password
    Column {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        anchors.bottomMargin: Math.round(root.height * 0.17)
        spacing: 0
        // while the session opens, the user group steps back a little
        opacity: root.busy ? 0.55 : 1
        Behavior on opacity { Ressort { caractere: "fondu" } }

        Glass {
            anchors.horizontalCenter: parent.horizontalCenter
            width: 80; height: 80; radius: 40
            opacity: root.stage(1)
            scale: 0.88 + 0.12 * root.settle(root.stage(1))
            Image {
                anchors.centerIn: parent
                width: 66; height: 66
                source: config.avatar
                sourceSize: Qt.size(132, 132)
                smooth: true; mipmap: true
                layer.enabled: true
                layer.effect: MultiEffect {
                    maskEnabled: true
                    maskSource: ShaderEffectSource {
                        sourceItem: Rectangle { width: 66; height: 66; radius: 33 }
                        width: 66; height: 66
                    }
                }
            }
        }
        Item { width: 1; height: 12 }
        Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.realName
            color: root.label
            font.family: root.texte; font.pixelSize: 15; font.weight: Font.DemiBold
            font.letterSpacing: root.tracking(15)
            style: Text.Raised; styleColor: "#33000000"
        }
        Item { width: 1; height: 16 }
        Glass {
            id: field
            anchors.horizontalCenter: parent.horizontalCenter
            // macOS shake: a damped oscillation, 3 swings in half a second
            property real shakeT: 1
            anchors.horizontalCenterOffset: 16 * Math.sin(shakeT * Math.PI * 6) * Math.pow(1 - shakeT, 1.5)
            opacity: root.stage(2)
            transform: Translate { y: 10 * (1 - root.settle(root.stage(2))) }
            width: 236; height: 36; radius: 18
            // focus ring in the Droplet accent, fades in
            Rectangle {
                anchors.fill: parent; anchors.margins: -3.5
                radius: field.radius + 3.5
                color: "transparent"
                border.width: 3; border.color: "#80ff2d55"
                opacity: password.activeFocus && !root.busy ? 1 : 0
                Behavior on opacity { Ressort { caractere: "fondu" } }
            }
            tint: root.day ? "#b3ffffff" : "#59101219"
            TextInput {
                id: password
                x: 16; width: parent.width - 52
                anchors.verticalCenter: parent.verticalCenter
                echoMode: TextInput.Password
                passwordCharacter: "•"
                color: root.day ? "#1d1d1f" : root.label
                font.family: root.texte; font.pixelSize: 13; font.letterSpacing: 1.5
                focus: true
                enabled: !root.busy
                clip: true
                onAccepted: root.doLogin()
                Text {
                    opacity: password.text.length ? 0 : 1
                    Behavior on opacity { Ressort { caractere: "fondu" } }
                    anchors.verticalCenter: parent.verticalCenter
                    text: "Saisissez le mot de passe"
                    color: root.day ? "#9e1d1d1f" : "#b3ffffff"
                    font.family: root.texte; font.pixelSize: 13; font.letterSpacing: root.tracking(13)
                }
            }
            Rectangle {
                id: go
                anchors.right: parent.right; anchors.rightMargin: 6
                anchors.verticalCenter: parent.verticalCenter
                width: 24; height: 24; radius: 12
                color: "#ec002d"
                // the arrow appears once something is typed, as on macOS
                opacity: password.text.length || root.busy ? 1 : 0.0
                scale: password.text.length || root.busy ? (goArea.pressed ? 0.88 : 1) : 0.6
                Behavior on opacity { Ressort { caractere: "vif" } }
                Behavior on scale { Ressort { caractere: goArea.pressed ? "vif" : "rebond" } }
                // while the session opens: a spinning arc instead of the arrow
                Canvas {
                    id: spinner
                    anchors.fill: parent
                    visible: root.busy
                    onPaint: { const c = getContext("2d"); c.reset(); c.strokeStyle = "#ffffff"; c.lineWidth = 2; c.lineCap = "round"
                               c.beginPath(); c.arc(12, 12, 6.5, 0, Math.PI * 1.4); c.stroke() }
                    RotationAnimation on rotation { running: root.busy; loops: Animation.Infinite; from: 0; to: 360; duration: 800 }
                }
                Canvas {
                    visible: !root.busy
                    anchors.fill: parent
                    onPaint: {
                        const c = getContext("2d"); c.reset()
                        c.strokeStyle = "#ffffff"; c.lineWidth = 1.8; c.lineCap = "round"; c.lineJoin = "round"
                        c.beginPath(); c.moveTo(7.5, 12); c.lineTo(16.5, 12); c.moveTo(12.5, 8); c.lineTo(16.5, 12); c.lineTo(12.5, 16); c.stroke()
                    }
                }
                MouseArea { id: goArea; anchors.fill: parent; anchors.margins: -4; onClicked: root.doLogin() }
            }
            NumberAnimation { id: shake; target: field; property: "shakeT"; from: 0; to: 1; duration: 520 }
        }
        Item { width: 1; height: 10 }
        Text {
            id: message
            anchors.horizontalCenter: parent.horizontalCenter
            text: keyboard.capsLock ? "Verrouillage des majuscules activé" : " "
            color: root.label
            opacity: text.trim().length ? 1 : 0
            Behavior on opacity { Ressort { caractere: "fondu" } }
            font.family: root.texte; font.pixelSize: 12
            style: Text.Raised; styleColor: "#33000000"
        }
    }

    function doLogin() {
        if (busy) return   // an empty password is allowed (live session user)
        busy = true
        sddm.login(root.userName, password.text, root.sessionIndex)
    }
    Connections {
        target: sddm
        function onLoginFailed() {
            root.busy = false
            password.text = ""
            message.text = "Mot de passe incorrect"
            shake.restart()
            password.forceActiveFocus()
        }
    }

    // ---------------------------------------------------------------- power (glass circles)
    Row {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom; anchors.bottomMargin: 34
        spacing: 60
        Repeater {
            model: [
                { label: "Suspendre", can: sddm.canSuspend, act: function() { sddm.suspend() }, glyph: "moon" },
                { label: "Redémarrer", can: sddm.canReboot, act: function() { sddm.reboot() }, glyph: "restart" },
                { label: "Éteindre", can: sddm.canPowerOff, act: function() { sddm.powerOff() }, glyph: "power" } ]
            delegate: Column {
                required property var modelData
                visible: modelData.can
                opacity: root.stage(3)
                spacing: 10
                Glass {
                    id: pw
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: 44; height: 44; radius: 22
                    scale: pwArea.pressed ? 0.9 : (pwArea.containsMouse ? 1.06 : 1)
                    Behavior on scale { Ressort { caractere: pwArea.pressed ? "vif" : "rebond" } }
                    Canvas {
                        anchors.fill: parent
                        onPaint: {
                            const c = getContext("2d"); c.reset()
                            c.strokeStyle = "#ffffff"; c.fillStyle = "#ffffff"; c.lineWidth = 2; c.lineCap = "round"
                            const g = modelData.glyph
                            c.beginPath()
                            if (g === "power") { c.arc(22, 23, 8, -Math.PI * .3, Math.PI * 1.3); c.moveTo(22, 12); c.lineTo(22, 21); c.stroke() }
                            else if (g === "restart") { c.arc(22, 22, 8, -Math.PI * .1, Math.PI * 1.5); c.stroke()
                                c.beginPath(); c.moveTo(22, 10.5); c.lineTo(26.5, 14); c.lineTo(21.5, 17); c.closePath(); c.fill() }
                            else { c.arc(22, 22, 8.5, 0, Math.PI * 2); c.fill()
                                c.globalCompositeOperation = "destination-out"; c.beginPath(); c.arc(27, 18, 7.5, 0, Math.PI * 2); c.fill() }
                        }
                    }
                    MouseArea { id: pwArea; anchors.fill: parent; hoverEnabled: true; onClicked: modelData.act() }
                }
                Text {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: modelData.label
                    color: root.label; opacity: .9
                    font.family: root.texte; font.pixelSize: 12; font.weight: Font.Medium
                    style: Text.Raised; styleColor: "#33000000"
                }
            }
        }
    }

    Component.onCompleted: password.forceActiveFocus()
}
