# =============================================================================
# DROPLET BOOT — Plymouth script (generated by export_plymouth.py, do not edit)
# Prismatic eclipse + liquid wordmark. All heavy rendering is pre-computed;
# this script only swaps images (25 fps on a 50 Hz refresh) -> light on any GPU.
# If anything fails to load, Plymouth falls back to its text splash.
# =============================================================================

Window.SetBackgroundTopColor(0.0314, 0.0353, 0.0510);       # Obsidian #08090D
Window.SetBackgroundBottomColor(0.0314, 0.0353, 0.0510);

W = Window.GetWidth();
H = Window.GetHeight();
cx = Window.GetX() + W / 2;
cy = Window.GetY() + H / 2 - H * 0.06;

mode = Plymouth.GetMode();
shutting = 0;
if (mode == "shutdown") shutting = 1;
if (mode == "reboot") shutting = 1;

# ---- load -------------------------------------------------------------------
fun scale_beam(img) {
  # beam strips are rendered for a 1920 px wide screen; stretch to this one
  bw = cx - @RW@ / 2 - Window.GetX();
  if (bw < 1) bw = 1;
  return img.Scale(bw, img.GetHeight());
}

if (shutting) {
  for (i = 0; i < @N_SHUT@; i++) shut[i] = Image("shut-" + i + ".png");
  for (i = 0; i < @N_SBEAM@; i++) sbeam[i] = scale_beam(Image("shutbeam-" + i + ".png"));
} else {
  for (i = 0; i < @N_INTRO@; i++) intro[i] = Image("intro-" + i + ".png");
  for (i = 0; i < @N_IDLE@; i++)  idle[i]  = Image("idle-" + i + ".png");
  for (i = 0; i < @N_BEAM@; i++)  beam[i]  = scale_beam(Image("beam-" + i + ".png"));
  for (i = 0; i < @N_BAR@; i++)   bar[i]   = Image("bar-" + i + ".png");
}

main = Sprite();
main.SetX(cx + @DX@);
main.SetY(cy + @DY@);
main.SetZ(2);

beam_sprite = Sprite();
beam_sprite.SetX(Window.GetX());
beam_sprite.SetY(cy - 6);
beam_sprite.SetZ(1);

bar_sprite = Sprite();
bar_sprite.SetX(cx - @BAR_W@ / 2);
bar_sprite.SetY(cy + @BAR_DY@ - @BAR_H@ / 2);
bar_sprite.SetZ(3);
bar_sprite.SetOpacity(0);

tick = 0;
progress = 0;
prompting = 0;

fun pingpong(j, n) {
  p = 2 * n - 2;
  j = j - Math.Int(j / p) * p;
  if (j >= n) j = p - j;
  return j;
}

fun refresh_callback() {
  tick++;
  t = tick / 50;
  f = Math.Int(t * 25);
  if (shutting) {
    if (f < @N_SHUT@) main.SetImage(shut[f]);
    else main.SetImage(shut[@N_SHUT@ - 1]);
    b = f - 37;                      # beam leaves at 1.5 s
    if (b >= 0 && b < @N_SBEAM@) { beam_sprite.SetImage(sbeam[b]); beam_sprite.SetOpacity(1); }
    else beam_sprite.SetOpacity(0);
    return;
  }
  if (f < @N_INTRO@) main.SetImage(intro[f]);
  else main.SetImage(idle[pingpong(f - @N_INTRO@, @N_IDLE@)]);

  if (f < @N_BEAM@) { beam_sprite.SetImage(beam[f]); beam_sprite.SetOpacity(1); }
  else beam_sprite.SetOpacity(0);

  # liquid progress bar: only for slow boots (appears at 3.6 s)
  if (t > 3.6 && prompting == 0) {
    a = (t - 3.6) / 0.4;
    if (a > 1) a = 1;
    idx = Math.Int(progress * (@N_BAR@ - 1));
    bar_sprite.SetImage(bar[idx]);
    bar_sprite.SetOpacity(a);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, p) { if (p > progress) progress = p; if (progress > 1) progress = 1; }
Plymouth.SetBootProgressFunction(progress_callback);

# ---- disk unlock --------------------------------------------------------------
pw_title = Sprite(Image("pw-title.png"));
pw_sub   = Sprite(Image("pw-subtitle.png"));
pw_field = Sprite(Image("pw-field.png"));
bead_img = Image("pw-bead.png");
pw_title.SetX(cx - pw_title.GetImage().GetWidth() / 2);
pw_title.SetY(cy + @PW_TITLE_DY@ - pw_title.GetImage().GetHeight() / 2);
pw_sub.SetX(cx - pw_sub.GetImage().GetWidth() / 2);
pw_sub.SetY(cy + @PW_SUB_DY@ - pw_sub.GetImage().GetHeight() / 2);
pw_field.SetX(cx - @PW_FIELD_W@ / 2);
pw_field.SetY(cy + @PW_FIELD_DY@ - pw_field.GetImage().GetHeight() / 2);
pw_title.SetZ(10); pw_sub.SetZ(10); pw_field.SetZ(10);
pw_title.SetOpacity(0); pw_sub.SetOpacity(0); pw_field.SetOpacity(0);

fun password_callback(prompt, count) {
  prompting = 1;
  bar_sprite.SetOpacity(0);
  pw_title.SetOpacity(1); pw_sub.SetOpacity(1); pw_field.SetOpacity(1);
  for (i = 0; beads[i] || i < count; i++) {
    if (!beads[i]) { beads[i] = Sprite(bead_img); beads[i].SetZ(11); }
    if (i < 12) {
      beads[i].SetX(cx - @PW_FIELD_W@ / 2 + 14 + i * @BEAD_GAP@);
      beads[i].SetY(cy + @PW_FIELD_DY@ - bead_img.GetHeight() / 2);
    }
    if (i < count && i < 12) beads[i].SetOpacity(1); else beads[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun normal_callback() {
  prompting = 0;
  pw_title.SetOpacity(0); pw_sub.SetOpacity(0); pw_field.SetOpacity(0);
  for (i = 0; beads[i]; i++) beads[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

# ---- messages (fsck...) discreetly at the bottom ---------------------------------
msg = Sprite();
msg.SetZ(10);
fun message_callback(text) {
  img = Image.Text(text, 0.52, 0.55, 0.62);
  msg.SetImage(img);
  msg.SetX(cx - img.GetWidth() / 2);
  msg.SetY(Window.GetY() + H - img.GetHeight() - 24);
}
Plymouth.SetMessageFunction(message_callback);
